{
  "name": "saigon-inventory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 execute saigon-inventory --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute saigon-inventory --remote --file=./migrations/0001_init.sql -y",
    "db:seed:local": "wrangler d1 execute saigon-inventory --local --file=./seed/sample.sql",
    "db:seed:remote": "wrangler d1 execute saigon-inventory --remote --file=./seed/sample.sql -y"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "qr-scanner": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  }
}

